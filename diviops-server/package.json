{
  "name": "@diviops/mcp-server",
  "version": "1.5.39",
  "description": "MCP server exposing Divi 5 Visual Builder as tools for Claude",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "diviops-mcp": "dist/index.js",
    "diviops-preset": "dist/preset-cli/bin.js",
    "diviops-cross-env-preflight": "dist/cross-env-preflight/bin.js"
  },
  "files": [
    "dist/**/*",
    "!dist/**/__tests__/**",
    "!dist/launcher-bootstrap.js",
    "!dist/launcher-bootstrap.d.ts",
    "!dist/launcher-sidecar.js",
    "!dist/launcher-sidecar.d.ts",
    "templates",
    "data/verified-attrs.json",
    "data/verified-attrs-backlog.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsc --watch",
    "test": "npm run build && node --test dist/__tests__/*.test.js dist/preset-cli/__tests__/*.test.js dist/cross-env-preflight/__tests__/*.test.js && node scripts/check-release-boundary.mjs",
    "prepublishOnly": "npm run build",
    "regen:skill": "node scripts/regen-module-formats.mjs"
  },
  "keywords": [
    "mcp",
    "divi",
    "wordpress",
    "claude",
    "visual-builder",
    "model-context-protocol"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oaris-dev/diviops.git",
    "directory": "diviops-server"
  },
  "bugs": {
    "url": "https://github.com/oaris-dev/diviops/issues"
  },
  "homepage": "https://github.com/oaris-dev/diviops/tree/main/diviops-server#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0"
  }
}
